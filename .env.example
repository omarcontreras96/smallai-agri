# Copy to .env.local and fill in. Never commit real values. All optional.
# Africa's Talking (sandbox: username is 'sandbox'). Leave empty to run offline with /inbox only.
AT_USERNAME=
AT_API_KEY=
AT_SHORTCODE=
# Salt for hashing phone numbers in the SQLite log (set your own in any real deployment)
PHONE_SALT=
# Optional paths: SQLite file (default data/service.db) and band file (default models/bands.json)
SMALLAI_DB=
BANDS_PATH=
